{
  "name": "agent-friendly-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src middleware.ts next.config.ts --ext .ts,.tsx",
    "test": "vitest run && node scripts/verify-network-rls.mjs && node scripts/verify-agents-v02.mjs",
