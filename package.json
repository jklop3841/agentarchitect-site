    "skill-glue:demo": "node ./bin/skill-glue.cjs compose ./examples/skill-glue/serial.json --format markdown",
    "workflow-shield": "node ./bin/workflow-shield.cjs",
    "workflow-shield:demo": "node ./bin/workflow-shield.cjs pack ./examples/workflow-shield/basic.json --format markdown"
  },
