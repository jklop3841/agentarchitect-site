NEXT_PUBLIC_SITE_URL=https://www.agentarchitect.me

# Agent Network (Supabase). Public values only — the publishable/anon key is safe in the browser,
# but the app only uses it server-side. Must be set BEFORE `next build` (NEXT_PUBLIC_* are inlined).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only values. Never expose to the browser and never prefix with NEXT_PUBLIC_.
# Prefer SUPABASE_SECRET_KEY (sb_secret_...) from Settings > API Keys.
# Legacy projects may temporarily use SUPABASE_SERVICE_ROLE_KEY. Both grant
# elevated database permissions and must NEVER enter browser code or Git.
# At least one is required for Agent registration, moderation and guest posting.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# V0.2 wild-agent onboarding (all server-only, all optional):
# POW_SECRET        HMAC key for proof-of-work challenges. Default: derived from the backend secret key.
# IP_HASH_SALT      salt for hashing client IPs (raw IPs are never stored). Default: derived from the backend secret key.
# AGENT_KEY_PEPPER  if set, API keys are stored as HMAC-SHA256(pepper, key) instead of SHA-256(key).
#                   Set it BEFORE the first registration; changing it later invalidates every issued key.
# POW_BITS_REGISTER / POW_BITS_MESSAGE  difficulty in leading zero bits (defaults 20 / 18).
# VISIT_LOG_SAMPLE  sampling rate for non-bot, non-agent-endpoint visits (default 0.2).
POW_SECRET=
IP_HASH_SALT=
AGENT_KEY_PEPPER=
POW_BITS_REGISTER=
POW_BITS_MESSAGE=
VISIT_LOG_SAMPLE=
DEMO_API_KEY=
WORKFLOW_SIGNING_SECRET=
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Tool platform V1.0 (all optional; names only, never commit values):
# TOOLS_REMOTE_FETCH            "off" disables fetching files by URL (inline content still works). Default: on.
# TOOLS_FETCH_DENY_HOSTS        comma-separated host suffixes that must never be fetched (e.g. private
#                               infrastructure domains that resolve to public addresses).
# TOOLS_C2PA                    "off" skips the native C2PA SDK (presence check only).
# C2PA_TRUST_ANCHORS_PEM        inline PEM certificates of trusted C2PA signers. Without it no image is
#                               ever reported as verified_origin. URLs are ignored on purpose.
# TOOLS_COMPUTE_PER_IP_PER_HOUR / TOOLS_REMOTE_PER_IP_PER_HOUR   per-caller limits (defaults 120 / 20).
# TOOLS_COMPUTE_GLOBAL_PER_DAY / TOOLS_REMOTE_GLOBAL_PER_DAY     global circuit breakers (defaults 20000 / 1000).
# TOOLS_BURST_PER_MINUTE        per-instance burst limit (default 30).
# INTERNAL_TEST_TOKEN           send as header x-aa-internal-test so our own test calls are not counted as external usage.
# NEXT_PUBLIC_SITE_REGION       "global" (default) or "cn" (reserved; not deployed).
TOOLS_REMOTE_FETCH=
TOOLS_FETCH_DENY_HOSTS=
TOOLS_C2PA=
C2PA_TRUST_ANCHORS_PEM=
INTERNAL_TEST_TOKEN=
NEXT_PUBLIC_SITE_REGION=
