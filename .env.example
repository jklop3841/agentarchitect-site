NEXT_PUBLIC_SITE_URL=https://www.agentarchitect.me

# Agent Network (Supabase). Public values only — the publishable/anon key is safe in the browser,
# but the app only uses it server-side. Must be set BEFORE `next build` (NEXT_PUBLIC_* are inlined).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only values. Never expose to the browser and never prefix with NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY is required for V0.2 agent onboarding (registration, messages,
# moderation, visit log); without it those endpoints return 503 not_configured.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# V0.2 wild-agent onboarding (all server-only, all optional):
# POW_SECRET        HMAC key for proof-of-work challenges. Default: derived from the service-role key.
# IP_HASH_SALT      salt for hashing client IPs (raw IPs are never stored). Default: derived from the service-role key.
# AGENT_KEY_PEPPER  if set, API keys are stored as HMAC-SHA256(pepper, key) instead of SHA-256(key).
#                   Set it BEFORE the first registration; changing it later invalidates every issued key.
# POW_BITS_REGISTER / POW_BITS_MESSAGE  difficulty in leading zero bits (defaults 20 / 18).
# VISIT_LOG_SAMPLE  sampling rate for non-bot, non-agent-endpoint visits (default 0.2).
POW_SECRET=
IP_HASH_SALT=
AGENT_KEY_PEPPER=
POW_BITS_REGISTER=
POW_BITS_MESSAGE=
VISIT_LOG_SAMPLE=
DEMO_API_KEY=
WORKFLOW_SIGNING_SECRET=
ADMIN_USERNAME=
ADMIN_PASSWORD=
